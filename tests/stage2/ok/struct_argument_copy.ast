Program
  Struct Point
    Field x i32 mut
    Field y i32 mut
    MemberFn move -> i32
      Param dx i32
      Param dy i32
      Block
        Assign x
          BinOp +
            Var x
            Var dx
        Assign y
          BinOp +
            Var y
            Var dy
        Exit
          Const 0
    MemberFn sum -> i32
      Block
        Decl result i32 const
          BinOp +
            Var x
            Var y
        Exit
          Var result
  Fn alter -> i32
    Param p Point
    Block
      Decl copy Point mut
        Var p
      CallStmt
        MemberCall move
          Var copy
          Const 1
          Const 2
      Exit
        FieldAccess copy.x
  Decl original Point const
    Const 10
    Const 20
  Print
    Call alter
      Var original
  Exit
    FieldAccess original.x
