Program
  Struct Point
    Field x i32 mut
    Field y i32 mut
    MemberFn move -> i32
      Param dx i32
      Param dy i32
      Block
        Assign x
          BinOp +
            Var x
            Var dx
        Assign y
          BinOp +
            Var y
            Var dy
        Exit
          Const 0
    MemberFn sum -> i32
      Block
        Decl result i32 const
          BinOp +
            Var x
            Var y
        Exit
          Var result
  Fn makePoint -> Point
    Block
      Decl p Point const
        Const 7
        Const 8
      Exit
        Var p
  Exit
    MemberCall sum
      Call makePoint
